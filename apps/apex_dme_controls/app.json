{
 "id": "apex_dme_controls",
 "title": "Apex DME Controls",
 "description": "One GT3 page on the center screen: engine map switching (MHD or BM3), the exhaust valve (OEM, open, closed) and MHD's Max Cooling. Maps switch only with the car stopped and the engine running. No xDrive control",
 "version": "0.5.0",
 "vendor": "custom",
 "loggingId": "OAD1",
 "iconGlyph": "DME",
 "shared": [
  "gt3ui.js",
  "sun.js",
  "tz.js",
  "night.js"
 ],

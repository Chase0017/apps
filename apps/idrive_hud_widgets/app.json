  "config": {
    "target": "hud",
    "statusName": "HUD",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "utcOffsetMinutes": null,
    "_comment": "socketPath: cluster-render's documented default. utcOffsetMinutes: leave null to use the head unit's own time zone; set it (e.g. -300 for EST) only if the HUD clock shows the wrong hour on the car. tankLitres: the fuel gauge's full mark (the car sends litres, not the tank size; a G01 X3 holds 65).",
    "dme": {
      "comment": "Boost from the engine unit (DME, ecu 18) over read-only UDS 0x22 while a boost readout is shown (the sport display's boost only when the engine unit gives none). Boost is intake MANIFOLD pressure (after the throttle): never the charge pipe (pressure before the throttle: PID 0x70 'boost pressure sensor A', DME 4205 IPLAD), which spikes when the throttle shuts on a lift or a shift (seen at 27 psi, Nov 13 2026). Absolute kPa, the outside air pressure (baro) is subtracted. Candidates tried in order, the first plausible one wins. From cauliflowermossgrape's car_vitals (MIT). Intake air temperature the same way (config.dme.intake, every 2 s, only while an intake readout shows); candidates from cruzen991/Cluster's signal table (MIT), unverified on this car.",
      "ecu": 18,
      "boost": [
        {
          "did": "4A2D",
          "bytes": 2,
          "at": 0,
          "factor": 0.0078125,
          "offset": 0,
          "min": 20,
          "max": 500,
          "note": "DRUCK_ABS_SAUGROHR, intake manifold absolute pressure, measured: hPa = raw * 20 / 256 (0..5120 hPa), DME8FF_R reference (EdiabasX SGBD docs)"
        },
        {
          "did": "580B",
          "bytes": 2,
          "at": 0,
          "factor": 0.00390625,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "IPSAU, intake manifold absolute pressure: hPa = raw * 10 / 256 (reads up to 2560 hPa, about 22 psi of boost), DME8FF_R reference (EdiabasX SGBD docs)"
        },
        {
          "did": "F487",
          "bytes": 2,
          "at": 1,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x87 intake manifold absolute pressure sensor A, 1/32 kPa"
        },
        {
          "did": "F40B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD PID 0x0B intake manifold absolute pressure, kPa (max 255 = 1.5 bar boost)"
        },
        {
          "obd": "0B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD service 01 PID 0x0B (same as F40B)"
        }
      ],
      "baro": [
        {
          "did": "F433",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD PID 0x33 barometric pressure, kPa (101.3 when not available)"
        },
        {
          "obd": "33",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD service 01 PID 0x33 (same as F433)"
        }
      ],
      "timing": [
        {
          "obd": "0E",
          "bytes": 1,
          "at": 0,
          "factor": 0.5,
          "offset": -64,
          "min": -64,
          "max": 63.5,
          "note": "OBD service 01 PID 0x0E timing advance, degrees before TDC (cylinder 1); the candidates M Vitals (cauliflowermossgrape, MIT) reads"
        },
        {
          "did": "F40E",
          "bytes": 1,
          "at": 0,
          "factor": 0.5,
          "offset": -64,
          "min": -64,
          "max": 63.5,
          "note": "the same PID over UDS 0x22"
        }
      ],
      "intake": [
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD PID 0x0F intake air temperature, C + 40"
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD PID 0x77 charge air cooler temperature, bank 1 sensor 1 (byte after the support byte), C + 40"
        },
        {
          "obd": "0F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD service 01 PID 0x0F (same as F40F)"
        }
      ]
    },
    "tankLitres": 65
  }
}

  "config": {
    "target": "panel",
    "statusName": "Cluster",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "utcOffsetMinutes": null,
    "waze": {
      "comment": "Show Waze map inside the theme (shared/waze.js): waze-on-cluster's status file (read every second) and its control socket (one short 'start' command, then closed). Paths from waze-on-cluster 0.9.3.",
      "status": "/run/waze-on-cluster/status.json",
      "control": "/dev/shm/waze-on-cluster/ctl.sock"
    },
    "_comment": "target panel: the whole 1920x720 instrument cluster, drawn over BMW's gauges. socketPath: cluster-render's documented default. utcOffsetMinutes: as in HUD Widgets (the clock box). tankLitres: the fuel gauge's full mark (the car sends litres, not the tank size; a G01 X3 holds 65). engine: the peak crank torque (Nm) and power (kW) the {{torquePct}} and {{powerPct}} tokens count from (an M40i: 500 Nm, 285 kW / 382 hp).",
    "dme": {
      "comment": "Boost from the engine unit (DME, ecu 18) over read-only UDS 0x22, only while the sport display sends no boost and a boost readout is shown. Absolute kPa, the outside air pressure (baro) is subtracted. Candidates tried in order, the first plausible one wins. From cauliflowermossgrape's car_vitals (MIT). Intake air temperature the same way (config.dme.intake, every 2 s, only while an intake readout shows); candidates from cruzen991/Cluster's signal table (MIT), unverified on this car. Oil pressure (config.dme.oilPressure, absolute bar; the outside air pressure from baro is subtracted), AFR (config.dme.afr, lambda x 14.7) and the first intake / baro candidates: BMW's own DME8FF_R identifiers, as cauliflowermossgrape's Live Data reads them; the OBD ones stay as fallbacks.",
      "ecu": 18,
      "boost": [
        {
          "did": "F470",
          "bytes": 2,
          "at": 3,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x70 boost pressure control: actual boost pressure sensor A (absolute), 1/32 kPa"
        },
        {
          "did": "F487",
          "bytes": 2,
          "at": 1,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x87 intake manifold absolute pressure sensor A, 1/32 kPa"
        },
        {
          "did": "F40B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD PID 0x0B intake manifold absolute pressure, kPa (max 255 = 1.5 bar boost)"
        },
        {
          "obd": "0B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
          "max": 255,
          "note": "OBD service 01 PID 0x0B (same as F40B)"
        }
      ],
      "baro": [
        {
          "did": "4201",
          "bytes": 2,
          "at": 0,
          "factor": 0.00390625,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "IPUMG, ambient pressure, u16 x 0.0390625 hPa -> kPa. DME8FF_R (MG1 DME: B58 / B48 / B38, G series), the identifiers cauliflowermossgrape's Live Data reads (MIT)"
        },
        {
          "did": "F433",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD PID 0x33 barometric pressure, kPa (101.3 when not available)"
        },
        {
          "obd": "33",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 50,
          "max": 115,
          "note": "OBD service 01 PID 0x33 (same as F433)"
        }
      ],
      "intake": [
        {
          "did": "580F",
          "bytes": 1,
          "at": 0,
          "factor": 0.75,
          "offset": -48,
          "min": -35,
          "max": 150,
          "note": "ITANS, intake air temperature, u8 x 0.75 - 48 C. DME8FF_R (MG1 DME: B58 / B48 / B38, G series), the identifiers cauliflowermossgrape's Live Data reads (MIT)"
        },
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD PID 0x0F intake air temperature, C + 40"
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD PID 0x77 charge air cooler temperature, bank 1 sensor 1 (byte after the support byte), C + 40"
        },
        {
          "obd": "0F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -35,
          "max": 150,
          "note": "OBD service 01 PID 0x0F (same as F40F)"
        }
      ],
      "afr": [
        {
          "did": "5889",
          "bytes": 2,
          "at": 0,
          "factor": 0.0035888671875,
          "offset": 0,
          "min": 8,
          "max": 30,
          "note": "ILAG1, lambda actual bank 1, u16 x 1/4096, times 14.7 for gasoline AFR. DME8FF_R (MG1 DME: B58 / B48 / B38, G series), the identifiers cauliflowermossgrape's Live Data reads (MIT)"
        },
        {
          "did": "5640",
          "bytes": 2,
          "at": 0,
          "factor": 0.003588858,
          "offset": 0,
          "min": 8,
          "max": 30,
          "note": "LAMBDA_SONDE_IST, lambda from the probe, as 5889. DME8FF_R (MG1 DME: B58 / B48 / B38, G series), the identifiers cauliflowermossgrape's Live Data reads (MIT)"
        },
        {
          "did": "F434",
          "bytes": 2,
          "at": 0,
          "factor": 0.0004486083984375,
          "offset": 0,
          "min": 8,
          "max": 30,
          "note": "OBD PID 0x34 wide-range O2 sensor bank 1 sensor 1: equivalence ratio (lambda) 2/65536 per bit, times 14.7 for gasoline AFR. Unverified on this car."
        },
        {
          "obd": "34",
          "bytes": 2,

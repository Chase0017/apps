{
  "id": "cluster_themes",
  "title": "Cluster Themes",
  "description": "Redraws the instrument cluster: GT3 race dash with shift lights, boost, temps and shift scoring",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OAC1",
  "iconGlyph": "CLU",
  "shared": [
    "hud.js",
    "hud_text.js",
    "hud_data.js",
    "hud_themes.js",
    "layouts.js",
    "shaders.js",
    "shift_score.js",
    "sun.js",
    "cluster_render_client.js"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Cluster Themes",
      "settings": true,
      "items": [
        [
          "text",
          "STATUS",
          "Starting the cluster"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "hudLayout",
      "label": "Theme",
      "type": "choice",
      "default": "gt3",
      "options": [
        [
          "gt3",
          "GT3"
        ]
      ]
    },
    {
      "key": "mapWindow",
      "label": "Leave room for the map",
      "type": "bool",
      "default": false
    },
    {
      "key": "units",
      "label": "Units",
      "type": "choice",
      "default": "us",
      "options": [
        [
          "us",
          "mph, °F, psi"
        ],
        [
          "metric",
          "km/h, °C, bar"
        ]
      ]
    },
    {
      "key": "clock",
      "label": "Clock",
      "type": "choice",
      "default": "12h",
      "options": [
        [
          "12h",
          "12-hour"
        ],
        [
          "24h",
          "24-hour"
        ]
      ]
    },
    {
      "key": "redline",
      "label": "Redline (shift light)",
      "type": "number",
      "unit": "rpm",
      "default": 7000,
      "steps": [
        5500,
        6000,
        6500,
        7000,
        7500
      ]
    },
    {
      "key": "shiftBefore",
      "label": "Shift point before redline",
      "type": "number",
      "unit": "rpm",
      "default": 300,
      "steps": [
        0,
        100,
        200,
        300,
        500,
        800,
        1000
      ]
    },
    {
      "key": "coldGuard",
      "label": "Cold-engine rev guard",
      "type": "bool",
      "default": true
    },
    {
      "key": "showBoost",
      "label": "Show boost",
      "type": "bool",
      "default": true
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto (until the car sends data)"
        ],
        [
          "on",
          "On"
        ],
        [
          "off",
          "Off"
        ]
      ]
    }
  ],
  "config": {
    "target": "panel",
    "statusName": "Cluster",
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "location": {
      "lat": 35.2271,
      "lon": -80.8431
    },
    "utcOffsetMinutes": null,
    "_comment": "target panel: the whole 1920x720 instrument cluster, drawn over BMW's gauges. socketPath: cluster-render's documented default. location and utcOffsetMinutes: as in HUD Widgets (the clock box)."
  }
}
